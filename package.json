{
  "name": "@aster/team-platform",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "customer/admin",
    "customer/demo",
    "customer/member",
    "operations/console",
    "website",
    "customer/sdk",
    "packages/ui"
  ],
  "scripts": {
    "ci:images:plan": "node ./scripts/ci/base-images.mjs --plan",
    "ci:images:build": "node ./scripts/ci/base-images.mjs --build",
    "ci:images:resume": "node ./scripts/ci/base-images.mjs --resume",
    "ci:images:check": "node ./scripts/ci/ci-images.mjs --check",
    "ci:builder": "node ./scripts/ci/builder-run.mjs",
    "ci:images:publish": "node ./scripts/ci/base-images.mjs --publish",
    "ci:images:update": "node ./scripts/ci/base-images.mjs --update",
    "test:ci-images": "node --test ./scripts/ci/base-images.test.mjs ./scripts/ci/runtime-boundary.test.mjs",
    "ci:cache:prune": "node ./scripts/ci/manage-actions-cache.mjs",
    "test:ci-cache": "node --test ./scripts/ci/actions-cache.test.mjs",
    "test:windows-services": "node --test ./scripts/windows-service-launch.test.mjs",
    "test:windows-release": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/ci/exercise-windows-release.ps1",
    "test:windows-runner-install": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/ci/exercise-windows-runner-install.ps1",
    "test:windows-pipeline:prepare": "node ./scripts/ci/prepare-windows-pipeline.mjs",
    "test:windows-pipeline": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/ci/exercise-windows-coexistence.ps1",
    "worktree:new": "node ./scripts/create-task-worktree.mjs",
    "setup": "node ./scripts/setup-development-tools.mjs",
    "setup:check": "node ./scripts/setup-development-tools.mjs --check",
    "setup:go": "node ./scripts/run-go-toolchain-setup.mjs",
    "setup:go:deps": "node ./scripts/run-go.mjs mod download",
    "setup:linux-lab": "node ./scripts/setup-windows-environment.mjs linux-lab",
    "setup:linux-lab:check": "node ./scripts/setup-windows-environment.mjs linux-lab --check",
    "setup:local": "node ./scripts/setup-local-stack.mjs",
    "dev": "node ./scripts/dev.mjs",
    "dev:manager": "node ./scripts/launch-local-dev-manager.mjs",
    "dev:stop": "python ./scripts/local_dev_manager.py --stop-all",
    "dev:admin": "npm run dev --workspace @aster/admin",
    "dev:member": "npm run dev --workspace @aster/member",
    "dev:api": "node ./scripts/run-rust-control.mjs",
    "dev:customer:migrate": "node ./scripts/run-rust-control.mjs --initialize-database",
    "dev:runner": "node ./scripts/run-rust-runner.mjs",
    "dev:operations": "npm run dev --workspace @aster/operations-console",
    "dev:operations:api": "node ./scripts/run-go-service.mjs run ./operations/backend/cmd/api --env-file ./data/local/operations.env",
    "dev:operations:migrate": "node ./scripts/run-go.mjs run ./operations/backend/cmd/api --env-file ./data/local/operations.env --migrate-only",
    "dev:website": "npm run dev --workspace @aster/website",
    "preview:website:release": "node ./website/tests/preview-release.mjs",
    "dev:website:cf": "npm run dev:cf --workspace @aster/website",
    "cf:website:types:check": "npm run cf:types:check --workspace @aster/website",
    "cf:website:migrate:local": "npm run cf:migrate:local --workspace @aster/website",
    "cf:website:migrate:remote": "npm run cf:migrate:remote --workspace @aster/website",
    "cf:website:deploy": "npm run cf:deploy --workspace @aster/website",
    "cf:website:publish": "python ./scripts/deploy_website_cloudflare.py",
    "setup:website-media": "playwright install chromium",
    "setup:delivery-tests": "playwright install chromium",
    "generate:website-media": "node ./scripts/generate-website-media.mjs",
    "build": "npm run build --workspaces --if-present && cargo build --workspace && npm run build:go",
    "build:go": "node ./scripts/run-go.mjs build -o ./dist/bin/ ./operations/backend/cmd/api ./operations/backend/cmd/backup ./operations/backend/cmd/webhost",
    "start": "node ./scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:go && npm run test:rust && npm run test --workspaces --if-present",
    "test:go": "node ./scripts/run-go.mjs test ./...",
    "check:customer:external-db:linux": "node scripts/check-customer-external-database-linux.mjs",
    "test:customer:external-db": "node scripts/test-customer-external-database.mjs",
    "test:environment-upgrades:db": "node ./scripts/test-environment-upgrades-db.mjs",
    "test:rust": "node ./scripts/run-rust-tests.mjs workspace",
    "test:rust:customer": "node ./scripts/run-rust-tests.mjs customer",
    "check:rust:customer": "cargo fmt --all -- --check && cargo clippy --workspace --exclude aster-release-tool --all-targets --features aster-control/sqlite-dev --jobs 2 -- -D warnings",
    "verify:customer": "node ./scripts/run-domain-verification.mjs customer",
    "verify:operations": "node ./scripts/run-domain-verification.mjs operations",
    "test:license-delivery:api": "node ./scripts/run-go.mjs test ./operations/backend/internal/application ./operations/backend/internal/transport/httpapi && cargo test -p aster-license-core && cargo test -p aster-control --no-default-features --features sqlite-dev license && cargo test -p aster-team-cli renders_a_compact_license_request_as_png_and_terminal_qr",
    "test:license-delivery:transports": "npm test --workspace @aster/operations-console -- --run test/license-request-import.test.ts",
    "test:license-delivery:browser": "playwright test --config ./tests/license-delivery/playwright.config.mjs",
    "test:license-delivery:member": "playwright test --config ./tests/license-delivery/member.playwright.config.mjs",
    "test:license-delivery:downloads:windows": "node ./tests/license-delivery/run-real.mjs --downloads",
    "test:license-delivery:real": "node ./tests/license-delivery/run-real.mjs",
    "test:license-delivery:admin": "playwright test --config ./tests/license-delivery/admin.playwright.config.mjs",
    "test:commercial:browser": "node ./tests/commercial-operations/run.mjs",
    "test:website:browser": "playwright test --config ./website/tests/playwright.config.mjs",
    "test:website:preview": "npm run check:preview --workspace @aster/website --",
    "test:website:downloads": "npm run test:downloads --workspace @aster/website",
    "test:website:release:windows": "node ./website/tests/run-release.mjs",
    "test:license-delivery": "npm run test:license-delivery:api && npm run test:license-delivery:transports && npm run test:license-delivery:browser && npm run test:license-delivery:member && npm run test:license-delivery:admin && npm run test:license-delivery:real",
    "test:system-e2e": "node ./tests/system-e2e/run.mjs",
    "test:system-e2e:headed": "node ./tests/system-e2e/run.mjs --headed",
    "test:system-e2e:live": "node ./tests/system-e2e/run.mjs --headed --upstream=live",
    "test:system-e2e:parallel": "node ./tests/system-e2e/run-parallel.mjs",
    "test:system-e2e:unit": "node --test ./tests/system-e2e/*.test.mjs",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --features aster-control/sqlite-dev -- -D warnings",
    "plugin:sign": "cargo run --quiet -p aster-plugin-core --features signing --bin aster-sign-plugin --",
    "build:linux": "node ./scripts/build-linux-bundle.mjs",
    "build:windows": "node ./scripts/build-windows-bundle.mjs",
    "build:windows-upgrade-fixture": "node ./scripts/ci/build-windows-upgrade-fixture.mjs",
    "build:asterctl:windows": "node ./scripts/build-asterctl-windows.mjs",
    "build:macos": "node ./scripts/build-macos-bundle.mjs",
    "release:prepare": "node ./scripts/prepare-release-version.mjs",
    "release:github": "node ./scripts/release-github.mjs",
    "release:tag": "node ./scripts/release-tag.mjs",
    "release:source": "node ./scripts/ci/customer-release-source.mjs",
    "release:publish": "node ./scripts/ci/publish-customer-release.mjs",
    "test:release-tag": "node --test ./scripts/release-github.test.mjs ./scripts/ci/customer-release-tag.test.mjs",
    "release:local": "node ./scripts/release-local.mjs",
    "release:preflight": "node ./scripts/run-release-security-preflight.mjs",
    "package:linux:amd64": "bash ./scripts/build-linux-amd64.sh",
    "seed:local": "node ./scripts/seed-local-demo.mjs",
    "seed:local-member": "node ./scripts/seed-local-member.mjs",
    "seed:local-ui-mock": "node ./scripts/seed-local-ui-mock.mjs",
    "demo:local": "npm run seed:local",
    "build:operations": "node ./scripts/build-operations-bundle.mjs",
    "build:website-release": "node ./scripts/build-website-bundle.mjs",
    "build:public-support": "node ./scripts/build-public-support-bundle.mjs",
    "verify:boundaries": "node ./scripts/verify-release-boundaries.mjs",
    "generate:contracts": "node ./tools/codegen/generate-contracts.mjs",
    "verify:contracts": "node ./tools/codegen/generate-contracts.mjs --check && node ./tools/codegen/verify-contracts.mjs",
    "verify:customer-logging": "node ./scripts/verify-customer-logging.mjs",
    "verify:customer-assets": "node ./scripts/verify-customer-production-assets.mjs",
    "verify:customer-admin-assets": "node ./scripts/verify-customer-production-assets.mjs --root=customer/admin/dist",
    "verify:customer-member-assets": "node ./scripts/verify-customer-production-assets.mjs --root=customer/member/dist",
    "verify:customer-sbom": "node ./scripts/generate-customer-sbom.mjs --check",
    "verify:docs": "node ./scripts/verify-documentation.mjs",
    "verify:caddy-format": "node ./scripts/verify-caddy-format.mjs",
    "verify:table-layout": "node --test ./scripts/verify-flat-table-cells.test.mjs && node ./scripts/verify-flat-table-cells.mjs",
    "verify:typography": "node ./scripts/verify-typography.mjs",
    "test:linux:doctor": "bash ./scripts/ci/linux-lab.sh doctor",
    "test:linux:primary": "bash ./scripts/ci/linux-lab.sh quick",
    "test:linux:full": "bash ./scripts/ci/linux-lab.sh full",
    "verify:linux": "npm run test:linux:full",
    "test:boundaries": "node --test ./scripts/verify-release-boundaries.test.mjs ./scripts/verify-customer-logging.test.mjs ./scripts/verify-customer-production-assets.test.mjs ./scripts/verify-changed.test.mjs ./scripts/verification-runner.test.mjs ./scripts/run-domain-verification.test.mjs ./scripts/run-rust-tests.test.mjs ./scripts/customer-release-profile.test.mjs ./scripts/customer-sbom.test.mjs ./scripts/setup-local-stack.test.mjs ./scripts/setup-windows-environment.test.mjs ./scripts/windows-docker-runtime.test.mjs ./scripts/release-download-cache.test.mjs ./scripts/local-env-file.test.mjs ./scripts/linux-installer-contract.test.mjs ./scripts/release-local.test.mjs ./scripts/prepare-release-version.test.mjs ./scripts/release-github.test.mjs ./scripts/ci/customer-release-tag.test.mjs ./scripts/build-public-support-bundle.test.mjs ./scripts/create-task-worktree.test.mjs ./tools/codegen/generate-contracts.test.mjs",
    "test:local-manager": "python -m unittest scripts/test_local_dev_manager.py scripts/test_local_pr_integration.py && node --test ./scripts/local-lan-development.test.mjs ./scripts/local-system-proxy.test.mjs",
    "verify:changed": "node ./scripts/verify-changed.mjs",
    "verify": "node ./scripts/run-full-verification.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitepress": "1.6.4",
    "vue-tsc": "^3.0.5",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "mysql2": "^3.23.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.4"
  }
}
