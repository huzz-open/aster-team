{
  "schema": "aster.install-layout.v1",
  "default_roots": {
    "linux": "/opt/aster-team",
    "windows": "C:\\ProgramData\\Aster Team",
    "macos": "/Library/Application Support/Aster Team"
  },
  "command_links": {
    "linux": "/usr/local/bin/aster-team-cli",
    "macos": "/usr/local/bin/aster-team-cli"
  },
  "service_registration_roots": {
    "linux": "/etc/systemd/system",
    "macos": "/Library/LaunchDaemons"
  },
  "release_paths": {
    "install_engine": {
      "linux": "libexec/install.sh",
      "windows": "libexec/install.ps1",
      "macos": "libexec/install-macos.sh"
    },
    "restore_engine": {
      "linux": "libexec/restore-backup.sh",
      "windows": "libexec/restore-backup.ps1",
      "macos": "libexec/restore-backup-macos.sh"
    },
    "service_templates": {
      "linux": "systemd",
      "macos": "launchd"
    },
    "service_launcher": {
      "windows": "windows/service-launch.ps1",
      "macos": "macos/service-launch.sh"
    }
  },
  "directories": [
    "stable_bin",
    "releases",
    "config",
    "cli_private",
    "control_config",
    "runner_config",
    "caddy_config",
    "service_config",
    "keys",
    "license",
    "tls",
    "data",
    "plugin_incoming_dir",
    "plugin_versions_dir",
    "database",
    "runner_data",
    "caddy_data",
    "runtime",
    "settlement_outbox",
    "state",
    "plugin_state_dir",
    "migration_state",
    "upgrade_state",
    "upgrade_queued",
    "upgrade_running",
    "upgrade_completed",
    "slots",
    "locks",
    "staging",
    "upgrade_uploads",
    "backups",
    "upgrade_backups",
    "logs"
  ],
  "paths": {
    "marker": "install.json",
    "stable_bin": "bin",
    "current": "current",
    "releases": "releases",
    "config": "config",
    "cli_private": "config/cli",
    "control_config": "config/control",
