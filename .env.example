ASTER_LOCAL_ADMIN_EMAIL=admin@example.com

# 可选：由本地 Python 控制台导入仓库外的生产签名根和 GitHub App 配置。
# 这里只保存目录路径，不保存任何密钥内容。留空时生成本地开发密钥，发布中心保持只读。
ASTER_LOCAL_SECURITY_CONFIG_DIR=

# 仅供 setup:local 一次性建库、建用户和授权；不会写入各服务运行配置。
ASTER_OPERATIONS_DB_HOST=127.0.0.1
ASTER_OPERATIONS_DB_PORT=3306
ASTER_OPERATIONS_DB_NAME=aster_operations
ASTER_OPERATIONS_DB_ADMIN_USER=root
ASTER_OPERATIONS_DB_ADMIN_PASSWORD=replace-with-a-database-administrator-password
ASTER_OPERATIONS_DB_ADMIN_TLS=false
ASTER_OPERATIONS_DB_SERVICE_USER=aster_operations
# 数据库与服务同机且通过 TCP 连接时使用 127.0.0.1；跨主机开发可按实际来源地址设置，% 会放宽来源范围。
ASTER_OPERATIONS_DB_SERVICE_HOST=127.0.0.1

ASTER_CUSTOMER_DB_HOST=127.0.0.1
ASTER_CUSTOMER_DB_PORT=3306
ASTER_CUSTOMER_DB_NAME=aster_customer
ASTER_CUSTOMER_DB_ADMIN_USER=root
ASTER_CUSTOMER_DB_ADMIN_PASSWORD=replace-with-a-database-administrator-password
ASTER_CUSTOMER_DB_ADMIN_TLS=false
ASTER_CUSTOMER_DB_SERVICE_USER=aster_customer
ASTER_CUSTOMER_DB_SERVICE_HOST=127.0.0.1
