ASTER_OPERATIONS_DB_DRIVER=mysql
ASTER_OPERATIONS_DB_HOST=127.0.0.1
ASTER_OPERATIONS_DB_PORT=3306
ASTER_OPERATIONS_DB_NAME=aster_operations
ASTER_OPERATIONS_DB_USER=aster_operations
ASTER_OPERATIONS_DB_PASSWORD=replace-with-a-dedicated-database-password
ASTER_OPERATIONS_DB_TLS=false
ASTER_OPERATIONS_DB_CHARSET=utf8mb4
ASTER_OPERATIONS_DB_PARSE_TIME=true
ASTER_OPERATIONS_DB_LOCATION=Local
ASTER_OPERATIONS_DB_MAX_OPEN_CONNS=10
ASTER_OPERATIONS_DB_MAX_IDLE_CONNS=10
ASTER_OPERATIONS_ADDR=127.0.0.1:12090
ASTER_OPERATIONS_AUTO_MIGRATE=false
ASTER_OPERATIONS_CREATE_DATABASE=false
ASTER_OPERATIONS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ASTER_OPERATIONS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Offline license signing keys remain only in this root-owned 0600 environment file.
ASTER_OPERATIONS_LICENSE_SIGNING_KEY_ID=license-v1
ASTER_OPERATIONS_LICENSE_SIGNING_PRIVATE_KEY_PKCS8=replace-with-base64url-ed25519-pkcs8
ASTER_OPERATIONS_CUSTOMER_REF_SECRET=replace-with-separate-random-32-byte-base64url-secret
# Optional v2 capabilities. Retain trusted public profiles when removing old private keys.
# Each signer: key_id, private_key_pkcs8, policy. Each verifier: key_id, public_key_spki, policy.
ASTER_OPERATIONS_LICENSE_V2_SIGNERS_JSON=
ASTER_OPERATIONS_LICENSE_V2_VERIFIERS_JSON=
# Explicit local or production; empty disables new paid approvals.
ASTER_OPERATIONS_FULFILLMENT_ENVIRONMENT=
# Relative paths are resolved below the --install-root selected by install.sh.
ASTER_OPERATIONS_ARTIFACT_ROOT=data/artifacts
ASTER_OPERATIONS_SESSION_SECURE=false
ASTER_OPERATIONS_SESSION_TTL=12h
ASTER_OPERATIONS_TRUSTED_ORIGINS=http://127.0.0.1:12080,http://localhost:12080

# Optional release-center GitHub App. Keep the App private key only in this root-owned 0600 file.
# Required repository permissions: Actions read/write, Contents read, Environments read.
ASTER_OPERATIONS_GITHUB_ENABLED=false
ASTER_OPERATIONS_GITHUB_APP_ID=
ASTER_OPERATIONS_GITHUB_INSTALLATION_ID=
ASTER_OPERATIONS_GITHUB_APP_PRIVATE_KEY_PEM_BASE64=
ASTER_OPERATIONS_GITHUB_REPOSITORY=huzz-open/aster-team
ASTER_OPERATIONS_GITHUB_WORKFLOW=customer-release.yml
ASTER_OPERATIONS_GITHUB_ENVIRONMENT=customer-release
ASTER_OPERATIONS_GITHUB_DEFAULT_REF=main
ASTER_OPERATIONS_GITHUB_POLL_INTERVAL=15s
ASTER_OPERATIONS_GITHUB_REQUEST_TIMEOUT=20s
ASTER_OPERATIONS_GITHUB_ARTIFACT_DOWNLOAD_TIMEOUT=5m
# Operations 只保存 Release 公钥环，用于独立复核 GitHub 构建结果；这里绝不能填写 Release seed/private key。
ASTER_OPERATIONS_RELEASE_TRUSTED_KEYS_JSON=[]
ASTER_OPERATIONS_RELEASE_ARTIFACT_MAX_BYTES=2147483648
ASTER_OPERATIONS_RELEASE_EXPANDED_MAX_BYTES=4294967296

# Optional formal publisher: use a second GitHub App with only Contents read/write. Do not reuse the build App.
ASTER_OPERATIONS_GITHUB_PUBLISH_ENABLED=false
ASTER_OPERATIONS_GITHUB_PUBLISH_APP_ID=
ASTER_OPERATIONS_GITHUB_PUBLISH_INSTALLATION_ID=
ASTER_OPERATIONS_GITHUB_PUBLISH_APP_PRIVATE_KEY_PEM_BASE64=
ASTER_OPERATIONS_GITHUB_PUBLISH_REPOSITORY=huzz-open/aster-team
ASTER_OPERATIONS_GITHUB_PUBLISH_API_URL=https://api.github.com
ASTER_OPERATIONS_GITHUB_PUBLISH_UPLOAD_URL=https://uploads.github.com
ASTER_OPERATIONS_GITHUB_PUBLISH_REQUEST_TIMEOUT=2m

# Environment upgrade credentials use a separate AES-256 key (standard base64).
# Generate once with openssl rand -base64 32, protect and back up outside MariaDB.
# Leave empty only when environment upgrades are not configured.
ASTER_OPERATIONS_UPGRADE_CREDENTIAL_KEY_BASE64=
