{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "functions/**/*.ts",
    "server/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
